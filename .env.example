# Copy to `.env` and fill in whichever provider you have access to.
# `.env` is gitignored. Never commit real keys.
#
# Only ONE of these is needed. The default configuration in configs/models.yaml
# uses OpenRouter for both model families.

# --- OpenRouter (default; one key covers both configured model families) ------
OPENROUTER_API_KEY=

# --- Google Gemini (alternative; enable `gemini-flash` in configs/models.yaml) -
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# --- Local Ollama (no key needed; enable `llama32-3b-local` in models.yaml) ----
# OLLAMA_HOST=http://localhost:11434
